generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL_MONGO")
}

enum LOAIDON {
  leave
  out
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  username String  @unique
  name     String
  password String?
  bophan   String?
  // line     String? 

  @@map("accounts")
}

model Employee {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  msnv   String  @unique
  hoten  String
  bophan String?
  active Boolean @default(true)

  @@map("employees")
}

model Form {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  ngaytao  DateTime @default(now()) @db.Date
  loaidon  LOAIDON  @default(leave)
  hoten    String
  msnv     String
  to       String
  lydo     String?
  thaythe  Boolean  @default(true)
  chuaxong Boolean  @default(false)
  totruong String?
  quandoc  String?
  lanhdao  String?

  songaynghi String?
  tungay     DateTime? @db.Date()
  denngay    DateTime? @db.Date()

  rangay DateTime? @db.Date()
  tugio  String?
  dengio String?

  giora  String?
  giovao String?

  @@map("forms")
}

model Salary {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  // employee   Employee @relation(fields: [employeeId], references: [id])
  // employeeId String   @db.ObjectId
  year  Int
  month Int

  hoten String
  msnv  String
  to    String
  cccd  String

  luongToiThieu          Int
  ngayCongBinhThuong     Float
  gioCongCN              Float?
  gioCongTangCa          Float?
  gioCaBa                Float?
  luongSPTheoCongDoan    Int
  luongSPTrongGio        Int
  luongTangCaCNCaBa      Int
  caBaCaDem              Int?
  huanLuyencongNhanMoi   Int?
  gioNghiTangCa          Float?
  luongNghiAnTangCa      Int?
  luongHanhKinhPhuNu     Int?
  gioConBuThai           Float?
  gioBatDauMangThai      Float?
  luongTanTatConNho      Int?
  hoTroConNhoDuoiMotTuoi Int?
  hoTroCongNhanMoi       Int?
  luongPCCC              Int?
  luongChuyenCan         Int?
  luongTheoNgayCong      Int?
  luongXangXe            Int?
  gioNghiNgan            Float?
  luongNghiNgan          Int?
  luongConDiNhaTre       Int?
  luongHoTroBoSung       Int?
  luongPhuCapNongCaDem   Int?
  luongATVSPCCC          Int?
  // tongCongTienLuongSanPhamCanCuBu Float?
  luongBu                Int?
  hoanTraBHXHBHYT        Int?
  ngayCheDo              Float?
  ngayPhepNam            Float?
  luongPhepCheDo         Int?
  // tongCongTienLuong         Float?
  luongBocXep            Int?
  truLuongUng            Int?
  truBHXH                Int?
  // tienLuongThucLinhCuoiKy Float?

  @@map("salaries")
}
