generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL_MONGO")
}

enum LOAIDON {
  leave
  out
}

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  username  String  @unique
  name      String
  password  String?
  bophan    String?
  fcm_token String?

  @@map("accounts")
}

model FormLeader {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  msnv  String  @unique
  hoten String?
  to    String?

  @@map("form_leaders")
}

model Employee {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  msnv      String    @unique
  hoten     String
  bophan    String?
  active    Boolean   @default(true)
  fcm_token String?
  cccd      String?
  ngaysinh  DateTime?

  @@map("employees")
}

model Form {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  ngaytao  DateTime @default(now()) @db.Date
  loaidon  LOAIDON  @default(leave)
  hoten    String
  msnv     String
  to       String
  lydo     String?
  thaythe  Boolean  @default(true)
  chuaxong Boolean  @default(false)
  totruong String?
  quandoc  String?
  lanhdao  String?

  songaynghi String?
  tungay     DateTime? @db.Date()
  denngay    DateTime? @db.Date()

  rangay DateTime? @db.Date()
  tugio  String?
  dengio String?

  giora     String?
  giovao    String?
  giamdocky Boolean @default(false)

  @@map("forms")
}

model Salary {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  thang DateTime @db.Date
  to    String
  cccd  String
  msnv  String
  hoten String

  luong_toi_thieu_cty                            Int?
  ngay_cong_binh_thuong                          Float?
  gio_cong_chu_nhat                              Float?
  gio_cong_tang_ca                               Float?
  ngay_gio_cong_ca_dem_ca3                       Float?
  tien_luong_sp_theo_cong_doan                   Int?
  tien_luong_sp_trong_gio                        Int?
  tien_luong_tang_ca_cn_ca3                      Int?
  phu_cap_ca3_ca_dem                             Int?
  bo_sung_luong_qd_943                           Int?
  tong_cong_tien_luong_sp                        Int?
  so_gio_nghi_tang_ca                            Float?
  tien_luong_nghi_an_tang_ca                     Int?
  tien_luong_1h5_hanh_kinh_nu                    Int?
  so_gio_thai_duoi_7_thang                       Float?
  so_gio_cho_con_bu_thai_tren_7_thang            Float?
  tien_luong_1h_cho_con_bu                       Int?
  ho_tro_10_phan_tram_luong_sp_con_duoi_12_thang Int?
  ho_tro_cn_moi_thang_1_2                        Int?
  tien_gio_hoc_tap_huan_luyen                    Int?
  tien_thuong_chuyen_can                         Int?
  bo_sung_luong_theo_ngay_cong                   Int?
  ho_tro_tien_xang_xe                            Int?
  gio_nghi_ngan                                  Float?
  tien_luong_nghi_ngan                           Int?
  tien_ho_tro_con_nha_tre                        Int?
  ho_tro_luong                                   Int?
  phu_cap_nong                                   Int?
  bo_sung_luong                                  Int?
  tong_cong_tien_luong_sp_bu_luong_toi_thieu     Int?
  tien_luong_bu                                  Int?
  hoan_tra_bhxh_bhtn_bhyt                        Int?
  ngay_che_do                                    Float?
  ngay_phep_nam                                  Float?
  tien_luong_phep                                Int?
  tong_cong_tien_luong                           Int?
  boc_xep                                        Int?
  tru_ung_truy_thu                               Int?
  bhxh_bhtn_bhyt                                 Int?
  tien_luong_thuc_linh                           Int?
  salaryNotes                                    SalaryNote[]

  @@map("salaries")
}

model SalaryNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  chat       String
  isEmployee Boolean  @default(true)
  salary     Salary   @relation(fields: [salaryId], references: [id])
  salaryId   String   @db.ObjectId
  createdAt  DateTime @default(now())

  @@map("salary_notes")
}

