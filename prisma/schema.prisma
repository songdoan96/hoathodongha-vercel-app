  gio_cong_tang_ca                               Float?
  ngay_gio_cong_ca_dem_ca3                       Float?
  tien_luong_sp_theo_cong_doan                   Int?
  tien_luong_sp_trong_gio                        Int?
  tien_luong_tang_ca_cn_ca3                      Int?
  phu_cap_ca3_ca_dem                             Int?
  bo_sung_luong_qd_943                           Int?
  tong_cong_tien_luong_sp                        Int?
  so_gio_nghi_tang_ca                            Float?
  tien_luong_nghi_an_tang_ca                     Int?
  tien_luong_hanh_kinh_nu                        Int?
  so_gio_thai_duoi_7_thang                       Float?
  so_gio_cho_con_bu_thai_tren_7_thang            Float?
  tien_luong_1h_cho_con_bu                       Int?
  ho_tro_10_phan_tram_luong_sp_con_duoi_12_thang Int?
  ho_tro_cn_moi_thang_1_2                        Int?
  tien_gio_hoc_tap_huan_luyen                    Int?
  tien_thuong_chuyen_can                         Int?
