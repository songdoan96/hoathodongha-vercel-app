model Overtime {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bophan String
  ngay   String
  gio    String
  lydo   String

  danhsach OvertimeEmployee[]

  totruong String
  quandoc  String?
  lanhdao  String?

  createdAt DateTime @default(now())

  @@map("overtimes")
}

type OvertimeEmployee {
  msnv  String
  hoten String
}
