generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL_MONGO")
}

enum LOAIDON {
  leave
  out
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  username String  @unique
  name     String
  password String?
  bophan   String?
  // line     String? 

  @@map("accounts")
}

model Employee {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  msnv   String  @unique
  hoten  String
  bophan String?
  active Boolean @default(true)

  @@map("employees")
}

model Form {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  ngaytao  DateTime @default(now()) @db.Date
  loaidon  LOAIDON  @default(leave)
  hoten    String
  msnv     String
  to       String
  lydo     String?
  thaythe  Boolean  @default(true)
  chuaxong Boolean  @default(false)
  totruong String?
  quandoc  String?
  lanhdao  String?

  songaynghi String?
  tungay     DateTime? @db.Date()
  denngay    DateTime? @db.Date()

  rangay DateTime? @db.Date()
  tugio  String?
  dengio String?

  giora  String?
  giovao String?

  @@map("forms")
}
